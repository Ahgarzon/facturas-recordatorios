# Ejecuta node docker/create-env.mjs para generar las cinco claves.
MONGO_ROOT_PASSWORD=
MONGO_API_PASSWORD=
MONGO_N8N_PASSWORD=
WORKFLOW_KEY=
N8N_ENCRYPTION_KEY=

APP_PORT=18080
N8N_PORT=15678
MAILPIT_PORT=18025

# Para n8n detrás de un proxy HTTPS, cambia estos cinco valores.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PROXY_HOPS=0
N8N_EDITOR_BASE_URL=http://localhost:15678
N8N_SECURE_COOKIE=false
